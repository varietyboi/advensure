# Root-level env template for quick setup.
# 1) Copy this file to apps/api/.env for the backend.
# 2) Optionally create apps/web/.env and copy VITE_API_URL for the frontend.

DATABASE_URL="postgresql://advensure:advensure@localhost:5432/advensure"
JWT_SECRET="replace-with-a-secure-value"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4000"
