{
	"name": "advensure-monorepo",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/web",
		"apps/api"
	],
	"scripts": {
		"dev:web": "npm run dev --workspace apps/web",
		"dev:api": "npm run dev --workspace apps/api",
		"build": "npm run build --workspace apps/web && npm run build --workspace apps/api",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"prisma:generate": "npm run prisma:generate --workspace apps/api",
		"prisma:migrate": "npm run prisma:migrate --workspace apps/api",
		"seed:demo": "npm run seed:demo --workspace apps/api"
	}
}

